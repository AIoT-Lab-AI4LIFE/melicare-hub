OPENAI_API_KEY=
# Pipeline: audio -> TRANSCRIBE_MODEL (chép lời) -> STRUCTURE_MODEL (transcript -> GT2 JSON)
# TRANSCRIBE_MODEL=gpt-transcribe
# STRUCTURE_MODEL=gpt-5.6-sol
# STRUCTURE_REASONING=medium

# Đăng nhập qua portal MELICARE + MeliAuth (mặc định dùng môi trường thật)
# AUTH_URL=https://auth.meliq.ai
# PORTAL_URL=https://melicare.meliq.ai/
# Chạy local: /login có nút "Đăng nhập giả (dev)"
# DEV_LOGIN=true
# MeliData archive (local run); Docker Compose uses melidata-api-1 on melidata_default.
MELIDATA_URL=http://127.0.0.1:3200
MELIDATA_TENANT_ID=development
# Auth-enabled deployments: set MELIDATA_TOKEN, or the three client-credentials settings below.
# MELIDATA_CLIENT_ID=melivoice-backend
# MELIDATA_CLIENT_SECRET=
# MELIDATA_TOKEN_URL=https://auth.meliq.ai/api/v1/auth/token
# Grants: melivoice.read melivoice.write system/Patient.read system/DocumentReference.write
CACHE_AUDIO_MAX_MB=512
CACHE_MAX_RECORDS=1000
# Thresholds report capacity only; cached data is not automatically deleted.
